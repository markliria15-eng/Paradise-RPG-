      "Elimine os filhotes antes que eles cerquem voce!",
      "Nao deixe os pequenos inimigos se acumularem!"
    ],
    "Orbes do Caos": [
      "Observe os orbes e desvie entre eles!",
      "Movimente-se de lado para escapar dos orbes magicos."
    ],
    "Ruptura Dimensional": [
      "Saia da area marcada antes da ruptura!",
      "Guarde sua esquiva para escapar da explosao dimensional."
    ],
    "Legiao Corrompida": [
      "Derrote os inimigos invocados antes de atacar o chefe!",
      "Evite ser cercado! Abra caminho entre os inimigos."
    ],
    "Esmagamento Colossal": [
      "O golpe e lento, mas poderoso! Saia da area marcada.",
      "Nao tente resistir ao impacto. Use sua esquiva!"
    ],
    "Pedras Arremessadas": [
      "Observe a trajetoria das pedras e mova-se de lado!",
      "Nao corra em linha reta! Varie sua direcao."
    ],
    "Espinhos Cristalinos": [
      "Saia das marcas no chao antes dos cristais surgirem!",
      "Os espinhos avisam antes de nascer. Fique atento!"
    ],
    "Fragmentacao Arcana": [
      "Afaste-se do cristal antes que ele exploda!",
      "Observe os fragmentos e procure um espaco seguro."
    ],
    "Pulso Cristalino": [
      "Afaste-se do centro antes da onda de energia!",
      "Guarde a esquiva para atravessar o pulso!"
    ],
    "Carga Infernal": [
      "O General avanca em linha reta! Desvie para o lado.",
      "Espere o sinal da carga e role para longe!"
    ],
    "Chao em Chamas": [
      "Nao fique sobre as chamas! Procure terreno seguro.",
      "Saia das areas vermelhas antes que o fogo apareca!"
    ],
    "Lancas Flamejantes": [
      "Observe onde as lancas vao cair e mude de posicao!",
      "Movimente-se entre as marcas para evitar as lancas."
    ],
    "veneno": [
      "O veneno causa dano com o tempo! Recupere sua vida.",
      "Evite novas doses de veneno enquanto se recupera!"
    ],
    "inimigo_comum": [
      "Enfrente poucos inimigos por vez e use suas pocoes!",
      "Melhore seus equipamentos antes de voltar a lutar!"
    ],
    "chefe_corpo_a_corpo": [
      "Ataque depois do golpe do chefe e recue!",
